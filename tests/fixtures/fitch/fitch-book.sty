% fitch-book.sty -- Fitch-style natural deduction for this book, on Selinger and Zach's fitch.sty.
%
% Loaded by latex/preamble.tex (the PDF) and by build/tikz.py's standalone template (the
% website, where each derivation is compiled to an SVG like a TikZ picture; see
% filters/tikz.lua). A derivation is a raw LaTeX block:
%
%   ```{=latex}
%   \begin{center}
%   $\begin{nd}
%     \hypo {1} {P \to Q}
%     \hypo {2} {Q \to R}
%     \open
%     \hypo {3} {P}
%     \have {4} {Q}  \ie{1,3}
%     \have {5} {R}  \ie{2,4}
%     \close
%     \have {6} {P \to R} \ii{3-5}
%   \end{nd}$
%   \end{center}
%   ```
%
% \open starts a box, \close ends it; \hypo is an assumption (fitch.sty draws the line under
% it); \have is a derived line. Two sibling boxes are simply \close \open. A justification is
% one of the rule macros below, or \by{any text}{line refs}. Line refs are "1,3" or "3-5".
%
% The rule macros exist ONLY inside the nd environment (fitch.sty defines them locally when
% the environment starts), so \ne keeps meaning "not equal" and \ni "contains" everywhere else.
% The names follow fitch.sty; the symbols follow the book (-> for implication, not =>).
\ProvidesPackage{fitch-book}
\RequirePackage{amssymb}
\RequirePackage[rules=bookndrules,justformat=bookjustformat]{fitch}
% "->E 1, 3", as the prose writes it (fitch.sty's default puts a comma after the rule name).
\newcommand{\bookjustformat}[2]{#1\ #2}
\def\bookndrules{%
  \def\ai{\by{$\wedge$I}}%       and
  \def\ae{\by{$\wedge$E}}%
  \def\ii{\by{${\to}$I}}%        implies
  \def\ie{\by{${\to}$E}}%
  \def\oi{\by{$\vee$I}}%         or
  \def\oe{\by{$\vee$E}}%
  \def\ni{\by{$\neg$I}}%         not
  \def\ne{\by{$\neg$E}}%
  \def\be{\by{$\bot$E}}%         contradiction
  \def\raa{\by{RAA}}%            reductio (classical)
  \def\bi{\by{${\leftrightarrow}$I}}%  iff
  \def\bie{\by{${\leftrightarrow}$E}}%
  \def\Ai{\by{$\forall$I}}%      quantifiers
  \def\Ae{\by{$\forall$E}}%
  \def\Ei{\by{$\exists$I}}%
  \def\Ee{\by{$\exists$E}}%
  \def\eqi{\by{$=$I}}%           equality
  \def\eqe{\by{$=$E}}%
  \def\r{\by{R}}%                repetition
  \def\nni{\by{$\neg\neg$I}}%    derived rules (Chapter 1), each proved once, then one line
  \def\nne{\by{$\neg\neg$E}}%
  \def\mt{\by{MT}}%
  \def\lem{\by{LEM}}%
  \def\ds{\by{DS}}%
  \def\dm{\by{DM}}%
  \def\ctp{\by{CP}}}
%
% Schema option: \begin{nd}[schema] makes each line print its own label instead of a number,
% for a rule pattern whose lines are i, j, k, ...; a line with an empty label ({} {\vdots})
% prints no number. The option is local to that one derivation.
\define@key{fitch}{schema}[true]{\def\nd@num##1{\nd@numo{##1}{##1}}}
